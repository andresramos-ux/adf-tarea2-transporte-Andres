{
	"name": "df_silver_incidentes",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_incidentes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(IncidenteId = trim(IncidenteId),",
				"          TipoIncidente = upper(trim(TipoIncidente)),",
				"          Severidad = upper(trim(Severidad)),",
				"          Descripcion = trim(Descripcion)) ~> derivedColumn1",
				"derivedColumn1 derive(FechaHoraInicio = iif(     instr(FechaHoraInicio, '/') > 0,     toTimestamp(FechaHoraInicio, 'dd/MM/yyyy'),     toTimestamp(         iif(length(trim(FechaHoraInicio)) == 10, concat(trim(FechaHoraInicio), ' 00:00:00'), trim(FechaHoraInicio)),         'yyyy-MM-dd HH:mm:ss'     ) ),",
				"          FechaHoraFin = iif(     instr(FechaHoraFin, '/') > 0,     toTimestamp(FechaHoraFin, 'dd/MM/yyyy'),     toTimestamp(         iif(length(trim(FechaHoraFin)) == 10, concat(trim(FechaHoraFin), ' 00:00:00'), trim(FechaHoraFin)),         'yyyy-MM-dd HH:mm:ss'     ) ),",
				"          FechaHoraRegistro = iif(     instr(FechaHoraRegistro, '/') > 0,     toTimestamp(FechaHoraRegistro, 'dd/MM/yyyy'),     toTimestamp(         iif(length(trim(FechaHoraRegistro)) == 10, concat(trim(FechaHoraRegistro), ' 00:00:00'), trim(FechaHoraRegistro)),         'yyyy-MM-dd HH:mm:ss'     ) ),",
				"          VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId) == '', toString(null()), trim(VehiculoId))) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(IncidenteId),",
				"     TipoIncidente = first(TipoIncidente),",
				"          Severidad = first(Severidad),",
				"          FechaHoraInicio = first(FechaHoraInicio),",
				"          FechaHoraFin = first(FechaHoraFin),",
				"          FechaHoraRegistro = first(FechaHoraRegistro),",
				"          VehiculoId = first(VehiculoId),",
				"          Descripcion = first(Descripcion)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> sink1"
			]
		}
	}
}