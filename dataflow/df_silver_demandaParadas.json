{
	"name": "df_silver_demandaParadas",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_demandaparadas_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_DemandaParadas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"derivedColumn4 derive(DemandaId = iif(     !isNull(DemandaId) && trim(DemandaId) != '',     trim(DemandaId),     concat(         'DM-',         toString(year(FechaServicio)),         '-',         lpad(toString(byName('row_num')), 5, '0')     ) ),",
				"          RutaHistoricaId = iif(     startsWith(trim(RutaHistoricaId), 'RH-'),     trim(RutaHistoricaId),     iif(         startsWith(trim(RutaHistoricaId), 'R12-'),         concat('RH-12-', right(trim(RutaHistoricaId), 1)),         iif(             startsWith(trim(RutaHistoricaId), 'R-'),             concat('RH-', substring(trim(RutaHistoricaId), 3, length(trim(RutaHistoricaId)))),             iif(                 startsWith(trim(RutaHistoricaId), 'Ruta '),                 concat('RH-', lpad(trim(substring(trim(RutaHistoricaId), 6, length(trim(RutaHistoricaId)))), 2, '0')),                 concat('RH-', lpad(trim(RutaHistoricaId), 2, '0'))             )         )     ) ),",
				"          ParadaHistoricaId = regexReplace(regexReplace(trim(ParadaHistoricaId), '(-MC)?-NEW$', ''), '^MC-01$', 'P220')) ~> derivedColumn1",
				"derivedColumn1 derive(Franja = trim(Franja),",
				"          ValidacionesTarjeta = iif(isNull(ValidacionesTarjeta) || trim(ValidacionesTarjeta) == '', 0, toInteger(trim(ValidacionesTarjeta)))) ~> derivedColumn2",
				"derivedColumn2 derive(Descensos = iif(isNull(Descensos) || trim(Descensos) == '', 0, toInteger(trim(Descensos))),",
				"          DemandaNoAtendida = iif(isNull(DemandaNoAtendida) || trim(DemandaNoAtendida) == '', 0, toInteger(trim(DemandaNoAtendida))),",
				"          Metodo = upper(trim(Metodo))) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(DemandaId),",
				"     FechaServicio = first(FechaServicio),",
				"          RutaHistoricaId = first(RutaHistoricaId),",
				"          ParadaHistoricaId = first(ParadaHistoricaId),",
				"          Franja = first(Franja),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          Descensos = first(Descensos),",
				"          DemandaNoAtendida = first(DemandaNoAtendida),",
				"          Metodo = first(Metodo)) ~> aggregate1",
				"source1 keyGenerate(output(row_num as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 derive(FechaServicio = iif(     instr(FechaServicio, '/') > 0,     toDate(FechaServicio, 'dd/MM/yyyy'),     iif(         length(trim(FechaServicio)) == 10,         toDate(FechaServicio, 'yyyy-MM-dd'),         addDays(toDate('1899-12-30'), toInteger(trim(FechaServicio)))     ) )) ~> derivedColumn4",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}